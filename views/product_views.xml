<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_po_cost" model="ir.ui.view">
        <field name="name">product.template.form.inherit.po.cost</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="purchase.view_product_supplier_inherit"/>
        <field name="arch" type="xml">
            <group name="purchase" position="after">
                <group name="po_cost" string="Cost from Purchase Orders" invisible="not po_cost_order_id">
                    <group>
                        <field name="po_cost_order_id"/>
                        <field name="po_cost_date"/>
                    </group>
                    <group>
                        <label for="po_cost_price"/>
                        <div class="o_row">
                            <field name="po_cost_price"/>
                            <field name="po_cost_currency_id" options="{'no_open': True}"/>
                        </div>
                    </group>
                </group>
            </group>
        </field>
    </record>

</odoo>
